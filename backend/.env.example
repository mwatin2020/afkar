APP_NAME=Private Task & Idea Vault API
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://vault_user:vault_password@localhost:5433/private_vault
SYNC_DATABASE_URL=postgresql://vault_user:vault_password@localhost:5433/private_vault
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
